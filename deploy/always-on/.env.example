# ========================================================================
# MiroFish Always-On Deployment — Environment Variables
# ========================================================================
# Copy this file to .env and fill in real values before starting.
# validate-deploy.sh checks that LLM_API_KEY and ZEP_API_KEY are present.

# -- Required: LLM provider credentials --
# These must NOT be placeholder values in production.
LLM_API_KEY=replace_with_openai_or_compatible_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=replace_with_zep_key

# -- Required for frontend -> backend routing --
VITE_API_BASE_URL=/api

# -- Required for TLS/domain overlay (docker-compose.tls.yml) --
# MIROFISH_DOMAIN: comma-separated list of app hostnames.
# PORTAL_DOMAIN: portal hostname (single value).
# ACME_EMAIL: Let's Encrypt registration email.
MIROFISH_DOMAIN=app.example.com,example.com
PORTAL_DOMAIN=portal.example.com
ACME_EMAIL=you@example.com

# -- Caddy reverse-proxy tuning --
# Ontology generation can take several minutes with large documents.
# These timeouts apply to the /api/* reverse proxy path.
API_MAX_UPLOAD_SIZE=100MB
API_RESPONSE_HEADER_TIMEOUT=600s
API_READ_TIMEOUT=600s
API_WRITE_TIMEOUT=600s
