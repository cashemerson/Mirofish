# Required: backend model provider credentials
LLM_API_KEY=replace_with_openai_or_compatible_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=replace_with_zep_key

# Required for frontend -> backend routing in containerized deploys
VITE_API_BASE_URL=/api

# Required for TLS/domain overlay (docker-compose.tls.yml)
MIROFISH_DOMAIN=app.example.com
PORTAL_DOMAIN=portal.example.com
ACME_EMAIL=you@example.com
