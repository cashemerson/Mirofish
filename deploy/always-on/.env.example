# Required: backend model provider credentials
LLM_API_KEY=replace_with_openai_or_compatible_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=replace_with_zep_key

# Required for frontend -> backend routing in containerized deploys
VITE_API_BASE_URL=/api

# Required for TLS/domain overlay (docker-compose.tls.yml)
# MIROFISH_DOMAIN accepts one or more app hosts, comma-separated.
# Example: MIROFISH_DOMAIN=app.example.com,example.com
MIROFISH_DOMAIN=app.example.com,example.com
PORTAL_DOMAIN=portal.example.com
ACME_EMAIL=you@example.com

# Optional Caddy reverse-proxy tuning for long-running upload/generation calls.
# Increase if ontology generation uploads are large or backend compute takes longer.
API_MAX_UPLOAD_SIZE=100MB
API_RESPONSE_HEADER_TIMEOUT=300s
API_READ_TIMEOUT=300s
API_WRITE_TIMEOUT=300s
