{$MIROFISH_DOMAIN} {
  encode zstd gzip
  tls {$ACME_EMAIL}

  @api path /api/*
  handle @api {
    reverse_proxy mirofish:5001
  }

  reverse_proxy mirofish:3000
}

{$PORTAL_DOMAIN} {
  encode zstd gzip
  tls {$ACME_EMAIL}
  basicauth {
    {$PORTAL_BASIC_AUTH_USER} {$PORTAL_BASIC_AUTH_HASH}
  }
  reverse_proxy portal:8080
}
