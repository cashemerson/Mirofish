__APP_HOSTS__ {
  encode zstd gzip
  tls __ACME_EMAIL__

  @api path /api/*
  handle @api {
    reverse_proxy mirofish:5001 {
      header_up Host localhost
    }
  }

  reverse_proxy mirofish:3000 {
    header_up Host localhost
  }
}

__PORTAL_HOSTS__ {
  encode zstd gzip
  tls __ACME_EMAIL__
  reverse_proxy portal:8080
}
